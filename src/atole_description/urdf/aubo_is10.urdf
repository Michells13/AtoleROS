      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="wrist2_joint" type="revolute">
    <parent link="wrist1_Link"/>
    <child link="wrist2_Link"/>
    <origin xyz="0 0.115 0" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- límites NOMINALES — ajustar al datasheet -->
    <limit lower="-6.2832" upper="6.2832" effort="200" velocity="3.0"/>
  </joint>
  <link name="wrist3_Link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://atole_description/meshes/link6.STL" scale="1 1 1"/></geometry>
      <material name="aubo_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://atole_description/meshes/link6.STL" scale="1 1 1"/></geometry>
    </collision>
    <!-- INERCIA NOMINAL (placeholder) — reemplazar con valores del datasheet AUBO iS10 -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="wrist3_joint" type="revolute">
    <parent link="wrist2_Link"/>
    <child link="wrist3_Link"/>
    <origin xyz="0 -0.102 0" rpy="1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- límites NOMINALES — ajustar al datasheet -->
    <limit lower="-6.2832" upper="6.2832" effort="200" velocity="3.0"/>
  </joint>
  <link name="tool0"/>
  <joint name="wrist3_to_tool0" type="fixed">
    <parent link="wrist3_Link"/>
    <child link="tool0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
