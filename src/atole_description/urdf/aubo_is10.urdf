      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="foreArm_joint" type="revolute">
    <parent link="upperArm_Link"/>
    <child link="foreArm_Link"/>
    <origin xyz="0.613 0 0" rpy="-3.14159265359 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- límites NOMINALES — ajustar al datasheet -->
    <limit lower="-6.2832" upper="6.2832" effort="200" velocity="3.0"/>
  </joint>
  <link name="wrist1_Link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
