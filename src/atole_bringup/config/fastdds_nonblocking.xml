<?xml version="1.0" encoding="UTF-8"?>
<!-- Envio UDP no bloqueante: si una interfaz se atasca (p.ej. usb0 del
     micro-USB con el host suspendido), DDS descarta el paquete en vez de
     bloquear el hilo de eventos y dejar el nodo invisible y sin poder cerrar. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_nb</transport_id>
      <type>UDPv4</type>
      <non_blocking_send>true</non_blocking_send>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>shm</transport_id>
      <type>SHM</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="nonblocking" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_nb</transport_id>
        <transport_id>shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
